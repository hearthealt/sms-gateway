# ============================================================
# 全仓库通用
# ============================================================
.idea/
*.iml
*.ipr
*.iws
.vscode/
.DS_Store
Thumbs.db
*.log

# ============================================================
# Android
# ============================================================
.gradle/
build/
captures/
.cxx/

# 签名材料与凭据：绝不可入库。
# release.jks 是正式签名私钥，泄漏等于别人可以签出能覆盖安装的包；
# keystore.properties 里是它的明文口令。
android/app/release.jks
android/app/keystore.properties
android/*.jks
android/*.keystore
*.jks
*.keystore

# 本机 SDK 路径，因机器而异，由 Gradle 自动生成
android/local.properties

# ============================================================
# 后端（Maven）
# ============================================================
backend/target/
!.mvn/wrapper/maven-wrapper.jar

# ============================================================
# 管理后台（Vite + Vue）
# ============================================================
management/node_modules/
management/dist/
management/.vite/
management/*.local
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
