# ============================================================================
# 本机开发配置模板
# ============================================================================
#
# 用法：
#     cp config/application.yml.example config/application.yml
# 然后按需改数据库口令、加密密钥那几项。
#
# 加了 .example 后缀的这份**进版本库**（里面只有占位符）；
# 真正的 config/application.yml **不进**（见 .gitignore），本机密钥写在那里。
#
# ---------------------------------------------------------------------------
# 这个文件为什么有用
# ---------------------------------------------------------------------------
#
# Spring Boot 会自动加载**工作目录**下的 ./config/application.yml（默认配置位置之一），
# 它的优先级**高于** classpath 里的 backend/src/main/resources/application.yml。
# 所以仓库里那份写的是默认值，这里写的是「本机实际生效的值」。
#
# 不把本机的值直接写进 application.yml，是因为那个文件进版本库 ——
# 数据库密码、加密密钥写进去就等于公开。这也是 docker/.env 单独存在的同一个理由。
#
# ---------------------------------------------------------------------------
# 三个必须知道的点
# ---------------------------------------------------------------------------
#
# 1. **这是覆盖，不是替换。** 没在这里写的项，仍然按 classpath 里的 application.yml
#    取值。所以下面刻意**只列本机真正会改的项** —— 把 dispatcher / http 那些调优参数
#    抄过来只会多出一份要同步维护的副本，改了源码那份、这里忘了改，实际生效的是这里
#    的旧值，排查起来毫无头绪。
#
# 2. **环境变量仍然优先于这个文件。** Spring Boot 的顺序是
#      命令行参数 > 系统属性(-D) > 环境变量 > 外部配置文件(本文件) > classpath 配置
#    所以 docker / 生产用环境变量配的那套完全不受影响 —— 它们赢过这里。
#
# 3. **改这个文件要重启**（它是启动时读的）。
#    运行期能改的那八项（转发总开关、附带来源信息、轮询间隔、失败阈值、短信保留天数、
#    清理时间、登录有效期、API Key 校验缓存）已经搬到数据库，在管理后台「系统设置」页改，
#    **不用重启** —— 下面没有它们。判断标准：密钥留配置，运行期策略进数据库。
#
# ---------------------------------------------------------------------------
# 工作目录（**最容易踩的一条**）
# ---------------------------------------------------------------------------
#
# Spring Boot 只加载**工作目录**下的 config/application.yml。这个文件在仓库根的 config/ 下，
# 所以只有当工作目录是仓库根时才生效：
#
#   · IDEA / Android Studio 里直接 Run 主类：工作目录默认是 $PROJECT_DIR$（仓库根）
#     → 就是这里，不用管。
#
#   · 命令行 cd backend && mvn spring-boot:run：**不生效**。
#     spring-boot-maven-plugin 的 workingDirectory 默认是 ${project.basedir}，也就是 backend/。
#     要指回仓库根，加一个参数：
#         mvn spring-boot:run -Dspring-boot.run.workingDirectory=..
#
# ⚠️ 忘了加这个参数**不会报错**：Spring Boot 找不到这个文件就静默跳过，用 classpath 里
#    application.yml 的默认值启动。表现是「我明明配了本机口令，它却在连 root/root」——
#    或者更糟，连上了别的库但你没察觉。放在 backend/config/ 下同理，那是另一个工作目录。
# ============================================================================

spring:
  datasource:
    # 本机 MySQL。docker 那套用容器名 mysql，靠环境变量覆盖，不受这里影响。
    url: jdbc:mysql://localhost:3306/sms_gateway?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8
    username: root
    password: root

  jpa:
    hibernate:
      # **不要改成 update / create**：建表由 backend/sql/schema.sql 负责，它是幂等的、
      # 全新库与老库升级共用同一条命令。让 Hibernate 自动改表会和那份脚本打架。
      ddl-auto: none
    # 想把 SQL 打出来排查问题时改成 true（会刷屏，查完记得关）
    show-sql: false

  data:
    redis:
      host: localhost
      port: 6379
      # 本机 Redis 通常没密码。docker 那套必须设 —— 里面明文存着管理员令牌与 API Key。
      password: ""

app:
  secret:
    # 系统主密钥：设备令牌 = HMAC-SHA256(deviceId, 它)。
    #
    # **本机开发建议就留着仓库里这个 DEV-ONLY 默认值，别换。** 换掉会让所有已签发的
    # 设备令牌立即失效 —— 你本机测过的每台手机都要重新扫码注册。启动日志里那句
    # 「仍是开发默认值」的告警是有用的提醒，看到它说明你确实在开发环境。
    #
    # 生产必须用环境变量 APP_SECRET_KEY 覆盖（docker/.env 里是 `:?` 语法，不配起不来）。
    key: DEV-ONLY-smart-gateway-change-me-3f9a

  admin:
    # 下面两项**只在 admin_user 表为空时**生效，也就是只在第一次建库时用得上。
    # 库已经有管理员账号了的话，改这里不会有任何效果。
    default-username: admin
    default-password: change-me

    # 轮换一个**已存在**账号的口令：临时填上新口令 → 重启 → 确认能登录 → 清空这里再重启。
    # 这是目前唯一能改管理员口令的途径（管理接口里没有这个功能），用完记得撤掉。
    reset-password: ""

  notify:
    # 渠道凭据（webhook 地址）的加密密钥，Base64 编码的 32 字节。
    #
    # 生成：openssl rand -base64 32
    #
    # **留空 = 转发不可启用**，应用照常启动（可选能力不该成为整个应用的启动依赖）。
    # 本机不测转发就保持空着；要测就生成一把填进来，再在「系统设置」页打开总开关。
    #
    # ⚠️ 换成另一把的话，已配的渠道凭据全部解不开，得重新填一遍。它**不能进数据库** ——
    #    渠道凭据是加密存库的，用库里的密钥去解库里的密文是循环依赖。
    encrypt-key: ""
