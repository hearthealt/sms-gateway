<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- 不要加 READ_SMS：本应用只从 SMS_RECEIVED 广播里取消息
         （Telephony.Sms.Intents.getMessagesFromIntent），从头到尾没读过系统短信库。
         声明用不到的短信读取权限，除了在首次启动时多弹一次危险权限，
         还会在应用市场上触发短信权限政策审查。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 应用锁用指纹/人脸代打 PIN。平台 BiometricPrompt 要求它；都是普通权限，不弹框。 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- 读取本机号码用于预填。多数 SIM 卡并不写入该号码，读不到属常态，
         设置页里手填的值才是权威来源。API 33 起用 READ_PHONE_NUMBERS。 -->
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- 用于把本机加入电池优化白名单。不加白名单时，MIUI 等 ROM 会在息屏后杀掉
         前台服务，短信从此停止上报且没有任何提示。部分 ROM 会拒绝该 action，
         代码里已退回「应用详情页」作为兜底。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 扫码导入配置用。只在扫码页按需申请，不并入启动时的批量申请：
         启动申请已经横跨三个权限组，再加相机就是四次弹窗，而相机权限每台设备
         一辈子只在配网时用一次 —— 混在里面一旦用户点错拒绝了短信权限，整个产品就废了。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- required="false" 是必须的：否则应用会被分发渠道从没有摄像头的设备上过滤掉，
         而本应用除了扫码之外完全不依赖相机。 -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- 关掉云备份。这个应用的数据没有一样适合备份：
         sms_gateway_prefs.xml 里是设备标识与 deviceToken（可冒充该设备上报与读取短信），
         sms_gateway.db 里是全部短信正文与验证码明文。开着的话它们会进用户的云端备份，
         换机恢复还会把**同一台设备的身份**搬到另一台手机上。
         代价是重装后要重新填服务器地址并重新注册 —— 二维码配网这条路本来就有。 -->
    <application
        android:name=".SmsGatewayApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmsGateway"
        tools:targetApi="34">

        <!-- 刻意**不**配 android:configChanges。
             曾经加过（orientation|uiMode|fontScale…），想的是「转屏与改字号别重建 Activity」，
             但那是把问题修在错的地方：重建本身是无害的，有害的是重建时无条件上锁
             与无条件申请权限 —— 那两条已经在 MainActivity.onCreate 里用
             savedInstanceState 判断修掉了（见那里的说明）。
             而声明 configChanges 之后，Configuration 的变化完全交给 Compose 自己去发现，
             一旦某条路径没接上（字号、深浅色都走过这种坑），表现就是「改了系统设置
             界面没变」，比多一次重建难查得多。

             windowSoftInputMode 用 adjustResize 而不是默认的 adjustPan：
             沉浸式 + 手势导航下，默认行为会让键盘**盖住**输入框，而 adjustResize
             把可用高度让给布局，配合各页面里的 imePadding()，输入框会自动滚进视野。
             设置页与锁屏这两处的输入框都吃过这个亏。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SmsGateway"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".receiver.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- 覆盖安装后重启服务：不加 MY_PACKAGE_REPLACED 的话，推一次版本更新
             就会让进程连同前台服务一起被杀且无人补拉，车队集体静默失联。
             它同时也是「可在后台启动前台服务」的官方豁免入口之一。 -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.GatewayForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>