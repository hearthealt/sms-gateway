<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 读取本机号码用于预填。多数 SIM 卡并不写入该号码，读不到属常态，
         设置页里手填的值才是权威来源。API 33 起用 READ_PHONE_NUMBERS。 -->
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- 用于把本机加入电池优化白名单。不加白名单时，MIUI 等 ROM 会在息屏后杀掉
         前台服务，短信从此停止上报且没有任何提示。部分 ROM 会拒绝该 action，
         代码里已退回「应用详情页」作为兜底。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 扫码导入配置用。只在扫码页按需申请，不并入启动时的批量申请：
         启动申请已经横跨三个权限组，再加相机就是四次弹窗，而相机权限每台设备
         一辈子只在配网时用一次 —— 混在里面一旦用户点错拒绝了短信权限，整个产品就废了。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- required="false" 是必须的：否则应用会被分发渠道从没有摄像头的设备上过滤掉，
         而本应用除了扫码之外完全不依赖相机。 -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".SmsGatewayApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmsGateway"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SmsGateway">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".receiver.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.GatewayForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>