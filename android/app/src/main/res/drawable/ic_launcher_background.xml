<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标背景层。铺满 108x108，遮罩裁掉哪块都不会露白。
     配色沿用管理后台 Login 页的 logo 渐变（#409EFF → #36D399）并整体压深一档，
     因为要衬纯白前景，原色对白的对比度在屏幕上偏虚。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF2B6BD8" />
                <item android:offset="0.5" android:color="#FF3D8BEE" />
                <item android:offset="1" android:color="#FF36D399" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
