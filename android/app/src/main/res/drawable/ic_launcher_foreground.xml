<?xml version="1.0" encoding="utf-8"?>
<!-- 启动图标前景：一封正在向外转发信号的信封。

     构图按自适应图标的规格来：所有内容都落在以 (54,54) 为心、半径 33 的圆内 ——
     这是任何遮罩形状下都保证可见的安全区。圆形遮罩下最外沿是 r=33，
     四角一旦越界就会被裁掉，所以信封和弧线的端点都按这个半径反算过。

     信封画成描边而非填充：背景是渐变，填充式信封的折线取不到一个
     处处吻合的背景色（无论填什么都有一条突兀的线）。描边则完全不依赖背景色。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 三道同心弧，自内向外不透明度递减，读作「一圈圈转发出去」 -->
    <path
        android:pathData="M43.66,49.24 A11,11 0 0 1 64.34,49.24"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M37.55,47.01 A17.5,17.5 0 0 1 70.45,47.01"
        android:strokeColor="#B3FFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M31.45,44.79 A24,24 0 0 1 76.55,44.79"
        android:strokeColor="#80FFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />

    <!-- 信封主体：圆角矩形轮廓 -->
    <path
        android:pathData="M39.5,57 L68.5,57 A2.5,2.5 0 0 1 71,59.5 L71,73.5 A2.5,2.5 0 0 1 68.5,76 L39.5,76 A2.5,2.5 0 0 1 37,73.5 L37,59.5 A2.5,2.5 0 0 1 39.5,57 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4"
        android:strokeLineJoin="round" />

    <!-- 信封盖折线 -->
    <path
        android:pathData="M39.5,59 L54,70.5 L68.5,59"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
